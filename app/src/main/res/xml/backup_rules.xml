<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde Android : seulement les réglages/signets (« p »), les positions (« pos ») et les statistiques
     (« stats »). Ni le cache de la bibliothèque, ni les pochettes, ni le jeton du service (« sec ») : les autorisations
     d'accès au dossier ne sont pas restaurées de toute façon. -->
<full-backup-content>
    <include domain="sharedpref" path="p.xml"/>
    <include domain="sharedpref" path="pos.xml"/>
    <include domain="sharedpref" path="stats.xml"/>
</full-backup-content>
